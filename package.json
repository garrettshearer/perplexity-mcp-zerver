{
  "name": "perplexity-mcp-zerver",
  "version": "0.3.1",
  "description": "MCP server using Puppeteer to interact with Perplexity.ai without an API key.",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "start": "bun build/main.js",
    "login": "bun build/login.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "biome lint . --write",
    "format": "biome format . --write",
    "dev": "bun run build && bun run start",
    "sync:openwebui": "bun bin/sync-openwebui.ts",
    "sync:perplexica": "bun bin/sync-perplexica.ts"
  },
  "keywords": [
    "mcp",
    "perplexity",
    "puppeteer",
    "ai",
    "research"
  ],
  "author": "sm-moshi",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.12.3",
    "@mozilla/readability": "0.6.0",
    "@types/axios": "0.9.36",
    "@types/form-data": "^2.5.2",
    "@types/jsdom": "21.1.7",
    "@types/mozilla__readability": "0.4.2",
    "axios": "1.10.0",
    "form-data": "^4.0.5",
    "jsdom": "26.1.0",
    "minimist": "1.2.8",
    "prune": "0.0.2",
    "puppeteer": "24.10.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/minimist": "1.2.5",
    "@types/node": "22.15.30",
    "@vitest/coverage-v8": "3.2.2",
    "bun-types": "latest",
    "typescript": "5.8.3",
    "vitest": "3.2.2"
  }
}